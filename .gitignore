# .gitignore
# ignore node_modules and other common stuff
node_modules/
dist/
*.pyc
*.log
*.cache
*.env
*.env.*
*.env.local
*.env.development
*.env.production

# ignore IDE files
.idea/
.vscode/
*.iml

# ignore generated files
*.egg-info/
__pycache__/
*.pyo
*.opt

# ignore other stuff
*.exe
*.o
*.obj
*.dll
*.so
*.dylib
*.a
*.lib
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar
